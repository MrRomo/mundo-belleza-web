---
// Navbar component with scroll behavior and dark mode toggle
import Button from './Button.astro';
import Phone from './icons/Phone.astro';
import ThemeToggle from './ThemeToggle.astro';

// Current path to determine active link
const currentPath = new URL(Astro.request.url).pathname;

// Function to generate NavLink classes
function getNavLinkClasses(href: string, isMobile = false) {
  const isActive = href === currentPath;
  const baseClasses = "font-medium transition-colors duration-300";
  const mobileClasses = "text-primary dark:text-gray-200 py-2 block border-b border-gray-100 dark:border-gray-700";
  const desktopClasses = `${isActive ? 'text-primary' : 'text-gray-700 dark:text-gray-200'} hover:text-primary dark:hover:text-primary-dark`;
  
  return isMobile ? `${baseClasses} ${mobileClasses}` : `${baseClasses} ${desktopClasses}`;
}
---

<header id="main-header" class="fixed top-0 left-0 right-0 z-50 transition-all duration-300 ease-in-out bg-transparent py-4">
  <div class="container mx-auto px-4 flex justify-between items-center">
    <!-- Logo -->
    <a href="/" class="flex items-center">
      <h1 class="text-2xl font-cursive font-bold text-primary dark:text-primary-dark">
        Mundo Belleza
      </h1>
    </a>

    <!-- Desktop Menu -->
    <nav class="hidden md:flex gap-8">
      <a href="/" class={getNavLinkClasses("/")}>Inicio</a>
      <a href="/productos" class={getNavLinkClasses("/productos")}>Productos</a>
    </nav>

    <!-- Right side: Contact button and theme toggle -->
    <div class="flex items-center space-x-4">
      <Button rounded={true} variant="primary" href="/contacto" class="hidden md:flex">
        <Phone class="mr-2 h-5 w-5" />Contactar
      </Button>
      
      <!-- Theme toggle -->
      <ThemeToggle />

      <!-- Mobile menu button - visible on mobile only -->
      <button 
        id="mobile-menu-button" 
        class="md:hidden p-2 rounded-md text-primary dark:text-primary-dark hover:bg-gray-100 dark:hover:bg-gray-800"
        aria-label="Abrir menú móvil"
      >
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6 menu-open-icon">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
        </svg>
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6 menu-close-icon hidden">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Menu - hidden by default -->
  <div id="mobile-menu" class="hidden md:hidden bg-white dark:bg-gray-800 shadow-lg">
    <div class="container mx-auto px-4 py-4 flex flex-col gap-4">
      <a href="/" class={getNavLinkClasses("/", true)}>Inicio</a>
      <a href="/productos" class={getNavLinkClasses("/productos", true)}>Productos</a>
      <a href="/contacto" class="bg-primary hover:bg-primary-800 text-default-text font-medium py-2 px-4 rounded-md text-center transition-colors duration-300">
        Contactar
      </a>
    </div>
  </div>
</header>

<script>
  // Variables for scroll behavior and mobile menu
  const header = document.getElementById('main-header');
  const mobileMenuButton = document.getElementById('mobile-menu-button');
  const mobileMenu = document.getElementById('mobile-menu');
  const menuOpenIcon = document.querySelector('.menu-open-icon');
  const menuCloseIcon = document.querySelector('.menu-close-icon');
  let mobileMenuOpen = false;

  // Handle scroll behavior
  function handleScroll() {
    if (header) {
      if (window.scrollY > 50) {
        header.classList.remove('bg-transparent', 'py-4');
        header.classList.add('bg-white/50', 'dark:bg-gray-800/50', 'shadow-md', 'py-2', 'backdrop-blur-md');
      } else {
        header.classList.add('bg-transparent', 'py-4');
        header.classList.remove('bg-white/50', 'dark:bg-gray-800/50', 'shadow-md', 'py-2', 'backdrop-blur-md');
      }
    }
  }

  // Toggle mobile menu
  function toggleMobileMenu() {
    mobileMenuOpen = !mobileMenuOpen;
    
    if (mobileMenu && menuOpenIcon && menuCloseIcon) {
      if (mobileMenuOpen) {
        mobileMenu.classList.remove('hidden');
        menuOpenIcon.classList.add('hidden');
        menuCloseIcon.classList.remove('hidden');
      } else {
        mobileMenu.classList.add('hidden');
        menuOpenIcon.classList.remove('hidden');
        menuCloseIcon.classList.add('hidden');
      }
    }
  }

  // Add event listeners
  window.addEventListener('scroll', handleScroll);
  if (mobileMenuButton) {
    mobileMenuButton.addEventListener('click', toggleMobileMenu);
  }

  // Initialize scroll state
  handleScroll();

  // Theme toggle functionality
  const themeToggle = document.getElementById('theme-toggle');
  
  if (themeToggle) {
    // Check for saved theme preference or use user's system preference
    const savedTheme = localStorage.getItem('theme');
    const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
    
    // Apply dark mode if previously saved or if user prefers dark mode
    if (savedTheme === 'dark' || (!savedTheme && prefersDark)) {
      document.documentElement.classList.add('dark');
    } else {
      document.documentElement.classList.remove('dark');
    }
    
    // Toggle theme when button is clicked
    themeToggle.addEventListener('click', () => {
      const isDark = document.documentElement.classList.toggle('dark');
      
      // Save preference to localStorage
      localStorage.setItem('theme', isDark ? 'dark' : 'light');
    });
  }
</script>
