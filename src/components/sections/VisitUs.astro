---
---

<section class="py-16 bg-default-bg">
    <div class="container mx-auto px-4">
        <h2 class="text-4xl font-bold text-center text-primary mb-4">Visítanos</h2>
        <p class="text-center text-default-text mb-12">Te esperamos en nuestra tienda para asesorarte personalmente</p>
        
        <div class="flex flex-col lg:flex-row gap-8">
            <!-- Información de contacto -->
            <div class="w-full lg:w-1/3">
                <h3 class="text-xl font-semibold mb-6">Información de contacto</h3>
                
                <div class="space-y-6">
                    <!-- Dirección -->
                    <div class="flex items-start">
                        <div class="bg-primary/10 p-3 rounded-full mr-4">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                            </svg>
                        </div>
                        <div>
                            <h4 class="font-medium">Dirección</h4>
                            <p class="text-default-text">Calle 5 cra 4-26, Guamal Magdalena</p>
                        </div>
                    </div>
                    
                    <!-- Teléfono -->
                    <div class="flex items-start">
                        <div class="bg-primary/10 p-3 rounded-full mr-4">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                            </svg>
                        </div>
                        <div>
                            <h4 class="font-medium">Teléfono</h4>
                            <p class="text-default-text">+57 312 345 6789</p>
                        </div>
                    </div>
                    
                    <!-- Email -->
                    <div class="flex items-start">
                        <div class="bg-primary/10 p-3 rounded-full mr-4">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                            </svg>
                        </div>
                        <div>
                            <h4 class="font-medium">Email</h4>
                            <p class="text-default-text">info@mundobelleza.com</p>
                        </div>
                    </div>
                    
                    <!-- Horario -->
                    <div class="flex items-start">
                        <div class="bg-primary/10 p-3 rounded-full mr-4">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                            </svg>
                        </div>
                        <div>
                            <h4 class="font-medium">Horario de Atención</h4>
                            <p class="text-default-text">Lunes a Viernes: 9:00 AM - 7:00 PM</p>
                            <p class="text-default-text">Sábados: 9:00 AM - 2:00 PM</p>
                        </div>
                    </div>
                </div>
            </div>
            
            <!-- Mapa -->
            <div class="w-full lg:w-2/3 bg-gray-200 rounded-lg min-h-[300px] flex items-center justify-center overflow-hidden">
                    <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d984.7751269155672!2d-74.22793273031913!3d9.145394823489497!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x8e5e8a7cf176533f%3A0x64fccb7c19309e0c!2s78%20%234%2C%20Guamal%2C%20Magdalena!5e0!3m2!1ses-419!2sco!4v1746221928796!5m2!1ses-419!2sco" width="100%" height="100%" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
            </div>
        </div>
    </div>
</section>
