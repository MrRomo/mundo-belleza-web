---

const brands = [
    {
        name: 'Magic Hair',
        image: '/magic-hair.png',
        letter: 'M',
    },
    {
        name: 'Mary Kay',
        image: '/mary-kay.png',
        letter: 'M',
    },
    {
        name: 'Milagros',
        image: '/milagros.png',
        letter: 'M',
    },
    {
        name: 'Anyeluz',
        image: '/anyeluz.png',
        letter: 'A',
    },
    {
        name: 'Kaba',
        image: '/kaba.png',
        letter: 'K',
    },
    {
        name: 'Poción',
        image: '/pocion.png',
        letter: 'P',
    },
];
---

<section id="brands" class=" bg-default-fg w-full">
    <!-- Contenido principal con padding ajustado -->
    <div class="container mx-auto px-4 pt-16 pb-8 mb-16 relative">
        <h2 class="text-3xl brand-title mb-8">Nuestras Marcas</h2>
        <div class="flex justify-center w-full flex-wrap gap-8">
            {brands.map((brand) => (
                <div class="flex flex-col items-center text-center">
                    <div class="relative mb-4 group">
                    <!-- Círculo con letra (visible si no hay imagen o como fallback) -->
                    <div class="w-32 h-32 rounded-full bg-primary flex items-center justify-center text-white text-4xl font-bold">
                        {brand.letter}
                    </div>
                    
                    <!-- Imagen (se posiciona encima del círculo) -->
                    <div class="absolute inset-0 w-32 h-32 rounded-full overflow-hidden">
                        <img 
                            src={brand.image} 
                            alt={brand.name} 
                            class="w-full h-full object-cover transition-opacity duration-300"
                        />
                    </div>
                    
                    <!-- Efecto hover -->
                    <div class="absolute inset-0 w-32 h-32 rounded-full bg-primary bg-opacity-0 group-hover:bg-opacity-20 transition-all duration-300"></div>
                </div>
                
                <!-- Nombre de la marca -->
                <h3 class="text-lg font-semibold text-primary">{brand.name}</h3>
                </div>
            ))}
        </div>
    </div>
</section>