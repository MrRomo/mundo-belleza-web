---

const brands = [
    {
        name: 'Magic Hair',
        image: 'https://images.unsplash.com/photo-1526947425960-945c6e72858f?q=80&w=300&auto=format&fit=crop',
        letter: 'M',
    },
    {
        name: 'Mary Kay',
        image: 'https://images.unsplash.com/photo-1522338242992-e1a54906a8da?q=80&w=300&auto=format&fit=crop',
        letter: 'M',
    },
    {
        name: 'Milagros',
        image: 'https://images.unsplash.com/photo-1571875257727-256c39da42af?q=80&w=300&auto=format&fit=crop',
        letter: 'M',
    },
    {
        name: 'Anyeluz',
        image: 'https://images.unsplash.com/photo-1596462502278-27bfdc403348?q=80&w=300&auto=format&fit=crop',
        letter: 'A',
    },
    {
        name: 'Kaba',
        image: 'https://images.unsplash.com/photo-1598452963314-b09f397a5c48?q=80&w=300&auto=format&fit=crop',
        letter: 'K',
    },
    {
        name: 'Poción',
        image: 'https://images.unsplash.com/photo-1599305090598-fe179d501227?q=80&w=300&auto=format&fit=crop',
        letter: 'P',
    },
];
---

<section id="brands" class=" bg-default-fg w-full py-8">
    <!-- Contenido principal con padding ajustado -->
    <div class="container mx-auto px-4 pt-16 pb-8 mb-16 relative">
        <h2 class="text-4xl font-bold brand-title mb-8 dark:text-white">Nuestras Marcas</h2>
        <div class="flex justify-center w-full flex-wrap gap-8">
            {brands.map((brand) => (
                <div class="flex flex-col items-center text-center">
                    <div class="relative mb-4 group">
                    <!-- Círculo con letra (visible si no hay imagen o como fallback) -->
                    <div class="w-56 h-56 rounded-full bg-primary flex items-center justify-center text-white text-4xl font-bold">
                        {brand.letter}
                    </div>
                    
                    <!-- Imagen (se posiciona encima del círculo) -->
                    <div class="absolute inset-0 w-56 h-56 rounded-full overflow-hidden">
                        <img 
                            src={brand.image} 
                            alt={brand.name} 
                            class="w-full h-full object-cover transition-opacity duration-300"
                        />
                    </div>
                    
                   
                </div>
                
                <!-- Nombre de la marca -->
                <h3 class="text-lg font-semibold text-primary dark:text-white">{brand.name}</h3>
                </div>
            ))}
        </div>
    </div>
</section>