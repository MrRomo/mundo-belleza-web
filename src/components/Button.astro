---
// Button component with multiple variants and styles
interface Props {
  type?: 'button' | 'submit' | 'reset';
  variant?: 'primary' | 'success' | 'info' | 'link' | 'warning' | 'danger' | 'default';
  size?: 'sm' | 'md' | 'lg';
  rounded?: boolean;
  outline?: boolean;
  block?: boolean; // Full width
  disabled?: boolean;
  href?: string; // If provided, renders as <a> instead of <button>
  class?: string; // Additional custom classes
}

const {
  type = 'button',
  variant = 'primary',
  size = 'md',
  rounded = false,
  outline = false,
  block = false,
  disabled = false,
  href,
  class: customClass = '',
  ...rest
} = Astro.props;

// Base classes for all buttons
let baseClasses = "inline-flex items-center justify-center font-medium transition-colors focus:outline-none focus:ring-2 focus:ring-offset-2";

if(!disabled) baseClasses += " cursor-pointer";
else baseClasses += " cursor-not-allowed";

// Size classes
const sizeClasses = {
  sm: "text-xs px-3 py-1.5",
  md: "text-sm px-4 py-2",
  lg: "text-base px-6 py-3"
};

// Colors for filled buttons
const filledClasses = {
  primary: "bg-primary hover:bg-primary-800 text-white focus:ring-primary-400",
  success: "bg-success hover:bg-success-800 text-white focus:ring-success-400",
  info: "bg-info hover:bg-info-800 text-white focus:ring-info-400",
  link: "bg-primary-200 hover:bg-primary-300 text-primary-800 focus:ring-primary-300",
  warning: "bg-warning hover:bg-warning-800 text-white focus:ring-warning-400",
  danger: "bg-danger hover:bg-danger-800 text-white focus:ring-danger-400",
  default: "bg-default-bg hover:bg-default-fg text-white focus:ring-default-400"
};

// Colors for outline buttons
const outlineClasses = {
  primary: "border border-primary text-primary hover:bg-primary-100 focus:ring-primary-400",
  success: "border border-success text-success hover:bg-success-100 focus:ring-success-400",
  info: "border border-info text-info hover:bg-info-100 focus:ring-info-400",
  link: "border border-primary-400 text-primary-600 hover:bg-primary-100 focus:ring-primary-300",
  warning: "border border-warning text-warning hover:bg-warning-100 focus:ring-warning-400",
  danger: "border border-danger text-danger hover:bg-danger-100 focus:ring-danger-400",
  default: "border border-default-fg text-white hover:bg-default-bg-100 focus:ring-default-300"
};

// Disabled styles
const disabledClasses = "opacity-60 cursor-not-allowed";

// Dark mode adjustments
const darkModeClasses = "dark:focus:ring-offset-gray-800";

// Block (full width) style
const blockClass = "w-full";

// Combine all classes
const variantClasses = outline ? outlineClasses[variant] : filledClasses[variant];
const classes = [
  baseClasses,
  sizeClasses[size],
  variantClasses,
  rounded ? 'rounded-full' : 'rounded-md',
  block ? blockClass : '',
  disabled ? disabledClasses : '',
  darkModeClasses,
  customClass
].join(' ');

// Determine if button should render as <a> or <button>
const isLink = !!href;
---

{isLink ? (
  <a 
    href={disabled ? undefined : href} 
    class={classes}
    aria-disabled={disabled}
    {...!disabled && rest}
  >
    <slot />
  </a>
) : (
  <button 
    type={type}
    class={classes}
    disabled={disabled}
    {...rest}
  >
    <slot />
  </button>
)}
