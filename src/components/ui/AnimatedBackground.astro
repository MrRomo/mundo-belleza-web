---
// Propiedades para personalizar el fondo animado
interface Props {
  primaryColor?: string;  // Color primario (por defecto usa la variable CSS)
  secondaryColor?: string; // Color secundario (por defecto usa la variable CSS)
  bottomColor?: string;   // Color de la onda inferior (para combinar con la siguiente sección)
  opacity?: number;       // Opacidad base de las ondas
  sensitivity?: number;   // Sensibilidad al movimiento del mouse (1-10)
  velocity?: number;      // Velocidad de las ondas
}

const {
  primaryColor = "var(--color-primary)",
  secondaryColor = "var(--color-secondary)",
  bottomColor = "var(--color-default-fg)", // Por defecto usa el color default-fg
  opacity = 0.15,
  sensitivity = 5,
  velocity = 1
} = Astro.props;
---

<div class="animated-background">
  <canvas id="waveCanvas" aria-hidden="true"></canvas>
</div>

<style define:vars={{ primaryColor, secondaryColor, opacity }}>
  .animated-background {
    position: absolute;
    top: 0;
    left: -10%; /* Extender hacia la izquierda */
    width: 120%; /* Aumentar el ancho para cubrir posibles espacios */
    height: 100%;
    z-index: -1;
    overflow: hidden;
  }

  canvas {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
  }
</style>

<script define:vars={{ sensitivity, velocity, bottomColor }}>
  document.addEventListener('DOMContentLoaded', function() {
    const canvas = document.getElementById('waveCanvas');
    if (!canvas || !(canvas instanceof HTMLCanvasElement)) return;

    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    // Configuración
    let width, height;
    let waves = [];
    let mouseX = 0;
    let mouseY = 0;
    let lastMouseX = 0;
    let lastMouseY = 0;
    let mouseSpeed = 0;
    const waveCount = 5;
    const baseSensitivity = sensitivity / 10; // Convertir escala 1-10 a 0.1-1

    // Función para redimensionar el canvas
    function resizeCanvas() {
      const container = canvas.parentElement;
      if (!container) return;
      
      // Aumentar el ancho en un 20% para asegurar que cubra todo el espacio
      // incluso cuando hay animación en los bordes
      width = Math.ceil(container.offsetWidth * 1.2);
      height = container.offsetHeight;
      
      canvas.width = width;
      canvas.height = height;
      
      // Reiniciar las ondas cuando cambia el tamaño
      initWaves();
    }

    // Función para obtener el color actual basado en el tema
    function getThemeColor(colorVar) {
      if (colorVar.startsWith('var')) {
        return getComputedStyle(document.documentElement).getPropertyValue(
          colorVar.substring(4, colorVar.length - 1)
        ).trim();
      }
      return colorVar;
    }
    
    // Inicializar las ondas
    function initWaves() {
      waves = [];
      
      // Crear múltiples ondas con propiedades diferentes
      for (let i = 0; i < waveCount; i++) {
        const isLastWave = i === waveCount - 1;
        const isPrimary = i % 2 === 0;
        
        waves.push({
          isLastWave: isLastWave,
          isPrimary: isPrimary,
          color: '', // Se establecerá en updateWaveColors()
          amplitude: Math.random() * 20 + 10, // Altura de la onda
          frequency: Math.random() * 0.01 + 0.005, // Frecuencia de la onda
          speed: (Math.random() * 0.05 + 0.02) * (Math.random() > 0.5 ? 1 : -1) * velocity, // Velocidad y dirección
          phase: Math.random() * Math.PI * 2, // Fase inicial
          opacity: isLastWave ? 1 : Math.random() * 0.1 + 0.05, // Mayor opacidad para la onda inferior
          yOffset: height * (i / waveCount), // Posición vertical
          points: [] // Puntos de la onda
        });
      }
      
      // Establecer los colores iniciales
      updateWaveColors();
    }
    
    // Actualizar los colores de las ondas (se llamará cuando cambie el tema)
    function updateWaveColors() {
      waves.forEach(wave => {
        if (wave.isLastWave) {
          // La última onda (la de abajo) usa el color especificado para combinar con la siguiente sección
          wave.color = getThemeColor(bottomColor);
        } else {
          // Las demás ondas alternan entre colores primario y secundario
          wave.color = wave.isPrimary ? 
            getThemeColor('var(--color-primary)') : 
            getThemeColor('var(--color-secondary)');
        }
      });
    }

    // Detector de cambios de tema para actualizar los colores
    const themeObserver = new MutationObserver(() => {
      // Cuando cambia el tema (se agrega o quita la clase 'dark' del html)
      updateWaveColors();
    });
    
    // Observar cambios en las clases del elemento html (para detectar cambios de tema)
    themeObserver.observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['class']
    });
    
    // Actualizar la posición y forma de las ondas
    function updateWaves(timestamp) {
      // Calcular velocidad del mouse
      const dx = mouseX - lastMouseX;
      const dy = mouseY - lastMouseY;
      const distance = Math.sqrt(dx * dx + dy * dy);
      
      // Suavizar la velocidad del mouse con un factor de suavizado mayor
      // Aumentamos el factor de suavizado de 0.9 a 0.95 para una transición más suave
      // Reducimos el factor de influencia de 0.1 a 0.05 para que los cambios sean más graduales
      mouseSpeed = mouseSpeed * 0.95 + distance * 0.05;
      
      // Suavizar también la posición del mouse para evitar saltos bruscos
      lastMouseX = lastMouseX * 0.8 + mouseX * 0.2;
      lastMouseY = lastMouseY * 0.8 + mouseY * 0.2;
      
      // Actualizar cada onda
      waves.forEach(wave => {
        // Actualizar fase con el tiempo y la velocidad
        wave.phase += wave.speed;
        
        // Calcular distancia del mouse a la posición vertical de la onda
        const mouseDistance = Math.abs(mouseY - wave.yOffset);
        // Reducir la influencia general y aplicar una curva más suave
        const distanceFactor = Math.pow(Math.max(0, 1 - mouseDistance / (height / 1.5)), 2);
        const mouseInfluence = distanceFactor * mouseSpeed * baseSensitivity * 0.7;
        
        // Actualizar puntos de la onda
        wave.points = [];
        
        // Crear puntos para la onda
        const pointCount = Math.ceil(width / 20); // Un punto cada 20px
        
        for (let i = 0; i <= pointCount; i++) {
          const x = (width * i) / pointCount;
          
          // Calcular distancia horizontal al mouse con un efecto más suave
          const xDistance = Math.abs(x - mouseX);
          // Aplicar una curva cuadrática para una transición más suave
          const xFactor = Math.pow(Math.max(0, 1 - xDistance / (width / 3)), 2);
          const xInfluence = xFactor * mouseInfluence * 0.8; // Reducir la intensidad general
          
          // Calcular altura de la onda en este punto
          const y = wave.yOffset + 
                    Math.sin(x * wave.frequency + wave.phase) * wave.amplitude + 
                    Math.sin(x * wave.frequency * 2 + wave.phase * 1.5) * wave.amplitude * 0.5 + 
                    xInfluence * 30; // Efecto del mouse
          
          wave.points.push({ x, y });
        }
      });
    }

    // Dibujar las ondas
    function drawWaves() {
      // Limpiar canvas
      ctx.clearRect(0, 0, width, height);
      
      // Dibujar cada onda
      waves.forEach(wave => {
        if (wave.points.length < 2) return;
        
        ctx.beginPath();
        
        // Empezar en el primer punto
        ctx.moveTo(wave.points[0].x, wave.points[0].y);
        
        // Dibujar curvas suaves entre los puntos
        for (let i = 0; i < wave.points.length - 1; i++) {
          const currentPoint = wave.points[i];
          const nextPoint = wave.points[i + 1];
          
          // Punto de control para la curva
          const cpX = (currentPoint.x + nextPoint.x) / 2;
          const cpY = (currentPoint.y + nextPoint.y) / 2;
          
          ctx.quadraticCurveTo(currentPoint.x, currentPoint.y, cpX, cpY);
        }
        
        // Cerrar la forma
        ctx.lineTo(width, height);
        ctx.lineTo(0, height);
        ctx.closePath();
        
        // Establecer color y opacidad
        const rgbColor = wave.color.startsWith('rgb') 
          ? wave.color 
          : `rgb(${wave.color})`;
        
        ctx.fillStyle = rgbColor.replace('rgb', 'rgba').replace(')', `, ${wave.opacity})`);
        ctx.fill();
      });
    }

    // Bucle de animación
    function animate(timestamp) {
      updateWaves(timestamp);
      drawWaves();
      requestAnimationFrame(animate);
    }

    // Manejar eventos del mouse
    function handleMouseMove(e) {
      const rect = canvas.getBoundingClientRect();
      mouseX = e.clientX - rect.left;
      mouseY = e.clientY - rect.top;
    }

    // Inicializar
    window.addEventListener('resize', resizeCanvas);
    document.addEventListener('mousemove', handleMouseMove);
    
    // Iniciar la animación
    resizeCanvas();
    requestAnimationFrame(animate);
    
    // Limpieza al desmontar
    return () => {
      window.removeEventListener('resize', resizeCanvas);
      document.removeEventListener('mousemove', handleMouseMove);
    };
  });
</script>
