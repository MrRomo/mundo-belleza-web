---
interface Props {
  id: string;
}

const { id } = Astro.props;
---

<div id={id} class="product-modal fixed inset-0 z-50 hidden">
  <!-- Overlay de fondo oscuro -->
  <div class="modal-overlay absolute inset-0 bg-black bg-opacity-50 backdrop-blur-sm"></div>
  
  <!-- Contenedor del modal -->
  <div class="modal-container relative w-full max-w-4xl mx-auto my-8 md:my-16 px-4">
    <!-- Contenido del modal -->
    <div class="modal-content bg-white dark:bg-gray-800 rounded-lg shadow-xl overflow-hidden max-h-[90vh] flex flex-col">
      <!-- Botón de cerrar -->
      <button class="modal-close absolute top-4 right-8 text-gray-500 hover:text-gray-700 dark:text-gray-300 dark:hover:text-white z-10">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
      
      <!-- Contenido dinámico del producto -->
      <div class="modal-body p-0 overflow-auto flex-grow">
        <div class="flex flex-col md:flex-row">
          <!-- Imagen del producto -->
          <div class="modal-image w-full md:w-1/2 bg-gray-100 dark:bg-gray-700">
            <img src="" alt="" class="w-full h-full object-cover aspect-square">
          </div>
          
          <!-- Detalles del producto -->
          <div class="modal-details p-6 w-full md:w-1/2">
            <!-- Marca -->
            <div class="flex items-center justify-start gap-4 mb-2">
              <span class="modal-brand text-xs font-light px-2 py-0.5 rounded-full bg-primary-900 text-white">Marca</span>
              <span class="modal-category text-xs font-light px-2 py-0.5 text-white rounded-full bg-secondary">Categoría</span>
            </div>
            
            <!-- Título -->
            <h2 class="modal-title text-2xl font-bold text-gray-900 dark:text-white mb-4">Título del Producto</h2>
            
            <!-- Descripción -->
            <p class="modal-description text-gray-700 dark:text-gray-300 mb-6">Descripción del producto</p>
            
            <!-- Características -->
            <div class="mb-6">
              <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-3">Características</h3>
              <ul class="modal-features space-y-2 list-disc pl-5 text-gray-700 dark:text-gray-300">
                <li>Calidad premium</li>
                <li>Resultados garantizados</li>
                <li>Fácil aplicación</li>
                <li>Ingredientes naturales</li>
              </ul>
            </div>
            
            <!-- Ingredientes -->
            <div class="mb-6">
              <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-3">Ingredientes</h3>
              <p class="modal-ingredients text-gray-700 dark:text-gray-300">
                Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed euismod, nisl vel ultricies lacinia, nisl nisl aliquam nisl, vitae aliquam nisl nisl sit amet nisl.
              </p>
            </div>
            
            <!-- Botón de WhatsApp -->
            <a href="#" class="modal-whatsapp flex items-center justify-center w-full bg-green-500 hover:bg-green-600 text-white font-medium py-3 px-4 rounded-md transition-colors duration-300">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" fill="currentColor" viewBox="0 0 24 24">
                <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
              </svg>
              Solicitar por WhatsApp
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  // Función para abrir el modal con los datos del producto
  function openProductModal(productData) {
    const modal = document.getElementById('product-modal');
    if (!modal) return;
    
    // Actualizar los datos del modal
    const modalImage = modal.querySelector('.modal-image img');
    const modalBrand = modal.querySelector('.modal-brand');
    const modalCategory = modal.querySelector('.modal-category');
    const modalTitle = modal.querySelector('.modal-title');
    const modalDescription = modal.querySelector('.modal-description');
    const modalWhatsapp = modal.querySelector('.modal-whatsapp');
    
    if (modalImage) {
      // Usar casting para acceder a propiedades específicas de HTMLImageElement
      const imgElement = modalImage as HTMLImageElement;
      imgElement.src = productData.image;
      imgElement.alt = productData.title;
    }
    
    if (modalBrand) modalBrand.textContent = productData.brand;
    if (modalCategory) modalCategory.textContent = productData.category;
    if (modalTitle) modalTitle.textContent = productData.title;
    if (modalDescription) modalDescription.textContent = productData.description;
    
    // Actualizar el enlace de WhatsApp
    if (modalWhatsapp) {
      const message = `Hola, estoy interesado/a en el producto: ${productData.title}`;
      // Usar casting para acceder a la propiedad href de HTMLAnchorElement
      const anchorElement = modalWhatsapp as HTMLAnchorElement;
      anchorElement.href = `https://wa.me/+1234567890?text=${encodeURIComponent(message)}`;
    }
    
    // Mostrar el modal con animación
    modal.classList.remove('hidden');
    setTimeout(() => {
      modal.classList.add('active');
    }, 10);
    
    // Bloquear el scroll del body
    document.body.style.overflow = 'hidden';
  }
  
  // Función para cerrar el modal
  function closeProductModal() {
    const modal = document.getElementById('product-modal');
    if (!modal) return;
    
    // Ocultar el modal con animación
    modal.classList.remove('active');
    setTimeout(() => {
      modal.classList.add('hidden');
    }, 300);
    
    // Restaurar el scroll del body
    document.body.style.overflow = '';
  }
  
  // Exportar las funciones para que estén disponibles globalmente
  // Usar una declaración de interfaz para extender Window
  interface Window {
    openProductModal: (productData: any) => void;
    closeProductModal: () => void;
    modalCleanupFunction?: () => void;
  }
  
  // Asignar las funciones al objeto window
  (window as any).openProductModal = openProductModal;
  (window as any).closeProductModal = closeProductModal;
  
  // Función para configurar los event listeners del modal
  function setupModalListeners() {
    const modal = document.getElementById('product-modal');
    if (!modal) return;
    
    // Limpiar event listeners anteriores si existen
    const win = window as any;
    if (win.modalCleanupFunction) {
      win.modalCleanupFunction();
    }
    
    const closeButton = modal.querySelector('.modal-close');
    const overlay = modal.querySelector('.modal-overlay');
    
    // Función para manejar la tecla ESC
    function handleEscKey(e: KeyboardEvent) {
      if (e.key === 'Escape' && modal && !modal.classList.contains('hidden')) {
        closeProductModal();
      }
    }
    
    // Agregar event listeners
    if (closeButton) {
      closeButton.addEventListener('click', closeProductModal);
    }
    
    if (overlay) {
      overlay.addEventListener('click', closeProductModal);
    }
    
    // Cerrar con la tecla ESC
    document.addEventListener('keydown', handleEscKey);
    
    // Guardar función de limpieza
    win.modalCleanupFunction = function() {
      if (closeButton) {
        closeButton.removeEventListener('click', closeProductModal);
      }
      
      if (overlay) {
        overlay.removeEventListener('click', closeProductModal);
      }
      
      document.removeEventListener('keydown', handleEscKey);
    };
  }
  
  // Configurar los event listeners cuando se carga el DOM
  document.addEventListener('DOMContentLoaded', setupModalListeners);
  
  // Configurar los event listeners después de las transiciones de vista
  document.addEventListener('astro:page-load', setupModalListeners);
</script>

<style>
  .product-modal {
    opacity: 0;
    transition: opacity 0.3s ease-in-out;
  }
  
  .product-modal.active {
    opacity: 1;
  }
  
  .modal-container {
    transform: translateY(20px);
    transition: transform 0.3s ease-in-out;
  }
  
  .product-modal.active .modal-container {
    transform: translateY(0);
  }
  
  .modal-body {
    max-height: calc(90vh - 2rem);
  }
  
  @media (max-width: 768px) {
    .modal-container {
      margin-top: 0;
      margin-bottom: 0;
      height: 100vh;
    }
    
    .modal-content {
      height: 100%;
      border-radius: 0;
    }
  }
</style>
