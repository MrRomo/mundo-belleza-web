---
interface Props {
  image: string;
  brand: string;
  title: string;
  description: string;
}

const { image, brand, title, description } = Astro.props;
---

<div class="bg-default-bg dark:bg-default-fg rounded-lg overflow-hidden shadow-md hover:shadow-lg transition-all duration-300 cursor-pointer hover:scale-105 ease-in-out">
  <div class="aspect-square bg-gray-100 flex items-center justify-center z-10 overflow-hidden relative">
    <!-- Etiqueta de marca (pill) en la esquina superior derecha -->
    <span class="absolute top-2 right-2 text-xs text-white font-medium px-2 py-0.5 rounded-full bg-primary-900 z-20 shadow-sm">
      {brand}
    </span>
    
    <img 
      src={image} 
      alt={title} 
      class="max-h-full object-contain hover:scale-110 transition-all duration-300 overflow-hidden"
      loading="lazy"
    />
  </div>
  
  <div class="p-4 z-20 flex flex-col gap-2">
    <h3 class="text-lg font-semibold font-sans">{title}</h3>
    <p class="text-sm text-default-text mb-4">{description}</p>
    
    <button class="bg-success text-white w-full py-2 px-4 rounded-md flex items-center justify-center hover:bg-success-400 transition-colors">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" viewBox="0 0 20 20" fill="currentColor">
        <path fill-rule="evenodd" d="M18 10c0 3.866-3.582 7-8 7a8.841 8.841 0 01-4.083-.98L2 17l1.338-3.123C2.493 12.767 2 11.434 2 10c0-3.866 3.582-7 8-7s8 3.134 8 7zM7 9H5v2h2V9zm8 0h-2v2h2V9zM9 9h2v2H9V9z" clip-rule="evenodd" />
      </svg>
      Solicitar por WhatsApp
    </button>
  </div>
</div>
