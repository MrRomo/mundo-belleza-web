---
interface Props {
  target: string;
}
import Button from './Button.astro';
import AnimatedBackground from './ui/AnimatedBackground.astro';

const { target } = Astro.props;
---

<section class="relative min-h-[60vh] flex items-center justify-center text-center px-4 pt-16 pb-32 overflow-hidden">
  <!-- Fondo animado con la onda inferior del mismo color que la sección de marcas -->
  <AnimatedBackground 
    opacity={10} 
    sensitivity={1} 
    velocity={0.3} 
    bottomColor="var(--color-default-fg)" 
  />
  <div class="max-w-4xl mx-auto">
    <!-- Logo/Icon -->
    <div class="bg-primary text-white w-24 h-24 rounded-full flex items-center justify-center mx-auto mb-8">
      <span class="text-2xl font-bold">MB</span>
    </div>
    
    <!-- Title and Subtitle -->
    <h1 class="text-5xl md:text-6xl lg:text-7xl font-bold text-primary mb-4">
      Mundo Belleza
    </h1>
    <p class="text-xl italic text-primary mb-6">
      Ama cuidarte
    </p>
    
    <!-- Description -->
    <p class="text-lg mb-10 max-w-2xl mx-auto text-default-text">
      Descubre nuestra exclusiva selección de productos para el cuidado personal,
      facial y capilar de las mejores marcas.
    </p>
    
    <!-- Call to Action Buttons -->
    <div class="flex flex-col sm:flex-row gap-4 justify-center mb-16">
      <Button variant="success" size="lg">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M18 10c0 3.866-3.582 7-8 7a8.841 8.841 0 01-4.083-.98L2 17l1.338-3.123C2.493 12.767 2 11.434 2 10c0-3.866 3.582-7 8-7s8 3.134 8 7zM7 9H5v2h2V9zm8 0h-2v2h2V9zM9 9h2v2H9V9z" clip-rule="evenodd" />
        </svg>
        Solicitar por WhatsApp
      </Button>
      <Button variant="primary" size="lg" href="/productos">
        Ver Productos
      </Button>
    </div>
    
    <!-- Scroll Down Indicator -->
    <a href={`#${target}`}class="absolute bottom-8 left-1/2 transform -translate-x-1/2 text-primary flex flex-col items-center animate-bounce">
      <span class="mb-2 text-sm">Descubre más</span>
      <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 " fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
      </svg>
    </a>
  </div>
</section>

<script is:inline>
  document.addEventListener('DOMContentLoaded', function() {
    const scrollLink = document.querySelector(`a[href="#${target}"]`);
    
    if (scrollLink) {
      scrollLink.addEventListener('click', function(e) {
        e.preventDefault();
        const targetElement = document.getElementById(target);
        if (targetElement) {
          window.scrollTo({
            top: targetElement.offsetTop,
            behavior: 'smooth'
          });
        }
      });
    }
  });
</script>
