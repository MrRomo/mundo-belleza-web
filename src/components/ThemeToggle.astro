---
// ThemeToggle component for switching between light and dark mode
import SunIcon from './icons/SunIcon.astro';
import MoonIcon from './icons/MoonIcon.astro';

interface Props {
  class?: string; // Additional classes for customization
}

const { class: additionalClasses = '' } = Astro.props;
---

<button 
  id="theme-selector" 
  class={`p-2 rounded-full bg-gray-100 dark:bg-gray-800 text-gray-500 dark:text-gray-400 hover:bg-gray-200 dark:hover:bg-gray-700 transition-colors ${additionalClasses} cursor-pointer`}
  aria-label="Cambiar modo oscuro"
>
  <!-- Sun icon (shown in dark mode) -->
  <SunIcon class="h-5 w-5 hidden dark:inline"/>
  
  <!-- Moon icon (shown in light mode) -->
  <MoonIcon class="h-5 w-5 dark:hidden"/>
</button>

<script is:inline>
document.getElementById('theme-selector')?.addEventListener('click', () => {
    if (localStorage.theme === 'dark') {
      localStorage.theme = 'light';
      document.documentElement.classList.remove('dark');
    } else {
      localStorage.theme = 'dark';
      document.documentElement.classList.add('dark');
    }
  });
</script>